{% macro socialMedia(name, url, label) %}
  <a href="{{ url }}" target="_blank" rel="noopener" title="{{ label }}" aria-label="{{ label }}" class="hover:text-brand-yellow transition-colors duration-200">
    {% if name == 'facebook' %}
      <svg width="24" height="24" viewBox="0 0 512 512" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M504 256C504 119 393 8 256 8S8 119 8 256c0 123.78 90.69 226.38 209.25 245V327.69h-63V256h63v-54.64c0-62.15 37-96.48 93.67-96.48 27.14 0 55.52 4.84 55.52 4.84v61h-31.28c-30.8 0-40.41 19.12-40.41 38.73V256h68.78l-11 71.69h-57.78V501C413.31 482.38 504 379.78 504 256z"/>
      </svg>
    {% endif %}
  </a>
{% endmacro %}

<footer class="bg-brand-primary text-white mt-16">
  <div class="container-wide grid grid-cols-1 md:grid-cols-3 gap-8 py-10">
    <div>
      <div class="font-display text-lg font-semibold mb-2">{{ site_name }}</div>
      <div class="text-sm leading-relaxed">
        {% if address %}{{ address }}<br>{% endif %}
        {% if email %}<a href="mailto:{{ email }}" class="underline hover:text-brand-yellow">{{ email }}</a>{% endif %}
      </div>
    </div>

    <div>
      {% if tax_number %}
        <div class="font-display text-lg font-semibold mb-2">{{ 'Adószám'|t }}</div>
        <div class="text-sm">{{ tax_number }}</div>
      {% endif %}
      {% if bank_name or bank_account %}
        <div class="font-display text-lg font-semibold mt-4 mb-2">{{ 'Bankszámlaszám'|t }}</div>
        <div class="text-sm">{% if bank_name %}{{ bank_name }}<br>{% endif %}{{ bank_account }}</div>
      {% endif %}
    </div>

    <div class="md:text-right">
      {% if facebook_url %}
        <div class="flex md:justify-end gap-4 mb-4">
          {{ _self.socialMedia('facebook', facebook_url, 'Facebook'|t) }}
        </div>
      {% endif %}
      <div class="text-xs text-white/80">
        © {{ 'now'|date('Y') }} {{ site_name }}<br>
        {{ 'Minden jog fenntartva.'|t }}
      </div>
    </div>
  </div>
</footer>
